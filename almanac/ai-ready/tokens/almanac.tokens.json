  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ],
        "$description": "OS UI stack. No webfonts. Trial: Work Sans (see $extensions).",
        "$extensions": {
          "com.almanac": {
            "trial": [
              "Work Sans",
              "ui-sans-serif",
              "system-ui",
              "sans-serif"
            ]
          }
        }
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Monaco",
          "Consolas",
          "Liberation Mono",
          "Courier New",
          "monospace"
        ],
        "$description": "Money, IDs, gauges. Rendered at 0.9em with tabular numerals."
      },
      "display": {
        "$type": "fontFamily",
        "$value": [
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ],
        "$description": "h1/h2. Trial: Newsreader.",
