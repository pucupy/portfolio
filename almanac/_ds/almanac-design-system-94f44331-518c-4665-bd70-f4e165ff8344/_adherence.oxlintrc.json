{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/data/**",
              "components/display/**",
              "components/forms/**",
              "components/navigation/**",
              "components/overlays/**",
              "components/patterns/**",
              "ui_kits/supplier-portal/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlmanacLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|variant|showWordmark|key|ref|className|style|children)$/]",
        "message": "<AlmanacLogo> doesn't accept that prop. Declared props: size, variant, showWordmark."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlmanacLogo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:gradient|mono|white|dark|outline)$/]",
        "message": "<AlmanacLogo> variant must be one of 'gradient' | 'mono' | 'white' | 'dark' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|onClick|className|key|ref|className|style|children)$/]",
        "message": "<BackLink> doesn't accept that prop. Declared props: children, href, onClick, className."
