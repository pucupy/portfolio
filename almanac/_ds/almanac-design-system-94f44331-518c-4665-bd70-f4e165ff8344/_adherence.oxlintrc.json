      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:accent|muted|outline|danger|success|warning)$/]",
        "message": "<Badge> variant must be one of 'accent' | 'muted' | 'outline' | 'danger' | 'success' | 'warning'."
      },
