{
  "$schema": "./contract.schema.json",
  "id": "cst.payment-summary",
  "name": "PaymentSummary",
  "version": "1.0.0",
  "status": "draft",
  "description": "One job: let someone check the amount, the payee and the account before they leave for their bank. Amount is the largest thing on the screen; the payee is named twice; the legal text sits above the button rather than below it, where nobody reads it.",
  "semantics": {
    "element": "section"
  },
  "props": [
    {
      "name": "amount",
      "type": "text",
      "default": "€2.00",
      "required": true,
      "description": "Largest element on the screen.",
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Amount"
        },
        "code": {
          "prop": "amount"
        }
      }
    },
    {
      "name": "payee",
      "type": "text",
      "default": "ACME",
      "required": true,
      "description": "Named in the summary and again in the authorisation line.",
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Payee"
        },
        "code": {
          "prop": "payee"
        }
      }
    },
    {
      "name": "account",
      "type": "text",
      "default": "Account ending 4268",
      "required": true,
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Account"
        },
        "code": {
          "prop": "account"
        }
      }
    },
    {
      "name": "authorisation",
      "type": "text",
      "default": "By continuing, you authorise Yapily Connect Ltd to initiate this €2.00 payment to ACME and agree to Yapily's Terms and Conditions and Privacy Policy.",
      "required": true,
      "description": "Legal copy. Above the button, always.",
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Authorisation"
        },
        "code": {
          "prop": "authorisation"
        }
      }
    }
  ],
  "states": [],
  "anatomy": {
    "root": {
      "layout": {
        "display": "flex",
        "direction": "column",
        "align": "stretch"
      },
      "tokens": {
        "gap": "{space.gap.stack}",
        "max-width": "{size.content-column}",
        "background-color": "{color.surface.modal}"
      },
      "parts": {
        "amountBlock": {
          "element": "p",
          "content": {
            "prop": "amount"
          },
          "tokens": {
            "font-size": "{font.amount.size}",
            "font-weight": "{font.amount.weight}",
            "color": "{color.surface.foreground}"
          }
        },
        "card": {
          "description": "Payee and account, on the canvas tint.",
          "layout": {
            "direction": "column",
            "align": "stretch"
          },
          "tokens": {
            "background-color": "{color.surface.summary}",
            "border-radius": "{radius.summary}",
            "padding-inline": "{space.inset-x.lg}",
            "padding-block": "{space.inset-y.md}",
            "gap": "{space.gap.control}"
          },
          "parts": {
            "payeeRow": {
              "element": "p",
              "content": {
                "prop": "payee"
              }
            },
            "accountRow": {
              "element": "p",
              "content": {
                "prop": "account"
              }
            }
          }
        },
        "legal": {
          "element": "p",
          "content": {
            "prop": "authorisation"
          },
          "tokens": {
            "font-size": "{font.legal.size}"
          }
        },
        "footer": {
          "description": "Only the footer component is accepted here — the button geometry is not redecided per screen.",
          "slot": {
            "name": "footer",
            "accepts": [
              "cst.button-footer"
            ],
            "required": true
          }
        }
      }
    }
  },
  "a11y": {
    "contrast": "AA"
  },
  "anchors": {
    "code": {
      "importPath": "src/journey/PaymentSummary",
      "export": "PaymentSummary"
    }
  }
}
