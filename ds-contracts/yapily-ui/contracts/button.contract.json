{
  "$schema": "./contract.schema.json",
  "id": "yui.button",
  "name": "Button",
  "version": "2.0.0",
  "status": "extracted",
  "source": {
    "file": "yapilyui.css",
    "repo": "yapily-brand/webroot",
    "lines": "2000–2160",
    "note": "Values transcribed from the shipped stylesheet, not authored for this contract."
  },
  "description": "Three variants, all 4px radius and 8px padding on a 1em label. Prominence is carried by fill and border only — size, radius and padding never change. Hover inverts primary and destructive to white; :active turns any non-destructive control blue and pulses once.",
  "semantics": {
    "element": "button",
    "role": "button"
  },
  "props": [
    {
      "name": "variant",
      "description": "Primary is black. Secondary is white with the system's single border colour. Destructive is the only red in the component set.",
      "type": {
        "enum": [
          "primary",
          "secondary",
          "destructive",
          "likea"
        ]
      },
      "default": "primary",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Variant",
          "values": {
            "primary": "Primary",
            "secondary": "Secondary",
            "destructive": "Destructive",
            "likea": "Like a link"
          }
        },
        "code": {
          "prop": "variant",
          "class": {
            "primary": "primary",
            "secondary": "secondary",
            "destructive": "destructive",
            "likea": "likea"
          }
        }
      }
    },
    {
      "name": "disabled",
      "description": "Kept at full colour and dropped to 0.9 opacity; hovering fades it to 0.5. The variant fill is retained rather than swapped for a neutral.",
      "type": "boolean",
      "default": false,
      "bindings": {
        "figma": {
          "kind": "BOOLEAN",
          "property": "Disabled"
        },
        "code": {
          "prop": "disabled"
        }
      }
    },
    {
      "name": "children",
      "description": "Label at 1em, regular Roobert. No uppercase, no letter-spacing.",
      "type": "text",
      "default": "Continue",
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Label"
        },
        "code": {
          "prop": "children"
        }
      }
    }
  ],
  "states": [
    "hover",
    "focus",
    "active",
    "disabled"
  ],
  "figmaStatePreviews": true,
  "anatomy": {
    "root": {
      "tokens": {
        "background-color": "{color.action.{variant}.background}",
        "color": "{color.action.{variant}.foreground}",
        "border": "{border.width.default} solid {color.action.{variant}.border}",
        "border-radius": "{radius.control}",
        "padding": "{space.inset.control}",
        "font-family": "{font.control.family}",
        "font-size": "{font.control.size}",
        "transition-duration": "{motion.transition}"
      },
      "states": {
        "hover": {
          "$note": "Primary and destructive invert to a white fill with their own colour as text and border. Secondary keeps its fill and darkens the border to black.",
          "background-color": "{color.surface.raised}",
          "color": "{color.action.{variant}.background}",
          "border-color": "{color.action.{variant}.background}"
        },
        "focus": {
          "border-color": "{color.border.focus}",
          "$note": "Destructive focuses to {color.border.error} instead."
        },
        "active": {
          "background-color": "{color.action.active.background}",
          "color": "{color.action.active.foreground}",
          "border-color": "{color.action.active.border}",
          "outline": "none",
          "animation": "pulse {motion.press} ease",
          "$note": "Destructive uses {color.action.destructive-active.*}."
        },
        "disabled": {
          "opacity": "{opacity.disabled}"
        }
      },
      "layout": {
        "display": "inline-flex",
        "direction": "row",
        "align": "center",
        "justify": "center"
      },
      "parts": {
        "icon": {
          "element": "svg",
          "optional": true,
          "tokens": {
            "margin-right": "{space.gap.small}"
          }
        },
        "label": {
          "element": "span",
          "content": {
            "prop": "children"
          }
        }
      }
    }
  },
  "a11y": {
    "focusVisible": true,
    "contrast": "AA",
    "notes": "Focus is a 1px black border on the control itself, with outline removed on :active. Hit area follows content — the source sets no min-height, so short labels can fall under 44px."
  },
  "anchors": {
    "css": {
      "file": "yapilyui.css",
      "selectors": [
        ".primary",
        ".secondary",
        ".destructive",
        "button.likea"
      ]
    }
  }
}
