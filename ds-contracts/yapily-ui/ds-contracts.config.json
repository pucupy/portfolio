{
  "$schema": "https://unpkg.com/@ds-contracts/schema/ds-contracts.config.schema.json",
  "name": "Yapily UI",
  "description": "Contracts extracted from the shipped Yapily UI stylesheet (2020–2022), the first version of the Yapily design system.",
  "source": {
    "stylesheet": "yapily-brand/webroot/yapilyui.css",
    "consumers": [
      "yapily-hub (hub.yapily.com demos and customer guidance)"
    ],
    "period": "2020–2022"
  },
  "contracts": "yapily-ui/contracts",
  "tokens": [
    "yapily-ui/tokens/primitives.tokens.json",
    "yapily-ui/tokens/semantic.tokens.json"
  ],
  "generate": {
    "target": "react",
    "out": "src/generated/yapily-ui",
    "stories": true
  }
}
