{
  "$schema": "./contract.schema.json",
  "id": "mrk.icon-tile",
  "name": "IconTile",
  "version": "1.0.0",
  "status": "draft",
  "description": "A 48px rounded square in the accent, holding a black glyph. The system's most recognisable unit — it labels a feature without an illustration budget. Never more than six per band.",
  "semantics": {
    "element": "span"
  },
  "props": [
    {
      "name": "glyph",
      "description": "Named glyph from the icon set. The tile never carries a bitmap.",
      "type": "text",
      "default": "account_balance",
      "required": true,
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Glyph"
        },
        "code": {
          "prop": "glyph"
        }
      }
    }
  ],
  "states": [],
  "anatomy": {
    "root": {
      "layout": {
        "display": "inline-flex",
        "direction": "row",
        "align": "center",
        "justify": "center"
      },
      "tokens": {
        "width": "{size.tile}",
        "height": "{size.tile}",
        "border-radius": "{radius.tile}",
        "background-color": "{color.tile.background}",
        "color": "{color.tile.glyph}"
      },
      "parts": {
        "glyph": {
          "icon": {
            "asset": "{glyph}",
            "size": 24
          },
          "tokens": {
            "width": "{size.glyph}",
            "height": "{size.glyph}"
          }
        }
      }
    }
  },
  "a11y": {
    "contrast": "AA"
  },
  "anchors": {
    "code": {
      "importPath": "src/mark/IconTile",
      "export": "IconTile"
    }
  }
}
