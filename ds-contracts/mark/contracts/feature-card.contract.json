{
  "$schema": "./contract.schema.json",
  "id": "mrk.feature-card",
  "name": "FeatureCard",
  "version": "1.0.0",
  "status": "draft",
  "description": "Icon tile, title, two lines. Cards do not carry their own links; the band carries one. Three or four per row. No border on paper bands, a 1px rule on panel bands — which is why the band tint is a prop rather than inherited.",
  "semantics": {
    "element": "article"
  },
  "props": [
    {
      "name": "title",
      "type": "text",
      "default": "Feature title",
      "required": true,
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Title"
        },
        "code": {
          "prop": "title"
        }
      }
    },
    {
      "name": "body",
      "type": "text",
      "default": "Two lines of supporting copy, no more.",
      "required": true,
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Body"
        },
        "code": {
          "prop": "body"
        }
      }
    },
    {
      "name": "band",
      "description": "Which band the card sits on. Decides whether it carries a rule.",
      "type": {
        "enum": [
          "paper",
          "panel"
        ]
      },
      "default": "paper",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Band",
          "values": {
            "paper": "Paper",
            "panel": "Panel"
          }
        },
        "code": {
          "prop": "band"
        }
      }
    }
  ],
  "states": [],
  "anatomy": {
    "root": {
      "layout": {
        "display": "flex",
        "direction": "column",
        "align": "start"
      },
      "tokens": {
        "gap": "{space.gap.card}",
        "padding-inline": "{space.inset-x.card}",
        "padding-block": "{space.inset-y.card}",
        "border-radius": "{radius.card}",
        "border-color": "{color.border.rule}",
        "border-width": "{border-width.100}",
        "font-family": "{font.display.family}"
      },
      "parts": {
        "tile": {
          "component": {
            "id": "mrk.icon-tile",
            "props": {
              "glyph": "account_balance"
            }
          }
        },
        "title": {
          "element": "h3",
          "content": {
            "prop": "title"
          },
          "tokens": {
            "font-size": "{font.feature-title.size}",
            "font-weight": "{font.feature-title.weight}",
            "line-height": "{font.feature-title.line-height}",
            "color": "{color.text.primary}"
          }
        },
        "body": {
          "element": "p",
          "content": {
            "prop": "body"
          },
          "tokens": {
            "font-size": "{font.body.size}",
            "line-height": "{font.body.line-height}",
            "color": "{color.text.primary}"
          }
        }
      }
    }
  },
  "a11y": {
    "contrast": "AA"
  },
  "anchors": {
    "code": {
      "importPath": "src/mark/FeatureCard",
      "export": "FeatureCard"
    }
  }
}
